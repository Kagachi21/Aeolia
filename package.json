{
  "name": "aeolia",
  "version": "1.0.0",
  "private": false,
  "description": "Aeolia — Dynamic Island for Windows with media, clipboard, calendar, prayer, capture, and system controls.",
  "author": "Aeolia",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.js",
    "start": "npm run build && node scripts/start.js",
    "probe": "npm run build && node dist/main/probe.js",
    "dist:setup": "npm run build && node scripts/build-win.js setup",
    "dist:portable": "node scripts/build-win.js portable",
    "dist:msix": "node scripts/build-win.js msix",
    "dist:all": "npm run build && node scripts/build-win.js all",
    "runtime": "electron-builder --win dir",
    "probe:r7:contract": "npm run build && node _probe-r7-contract.js",
    "probe:r7:notice": "npm run build && electron _probe-r7-notice-live.js",
    "probe:r7:mic": "npm run build && electron _probe-r7-mic-live.js",
    "probe:r7:cam": "npm run build && electron _probe-r7-cam-live.js",
    "probe:r7:glass": "npm run build && electron _probe-r7-glass.js",
    "probe:r7:all": "npm run build && node _probe-r7-run-all.js"
  },
  "dependencies": {
    "koffi": "^3.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "electron": "^45.2.3",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.aeolia.island",
    "productName": "Aeolia",
    "copyright": "Aeolia",
    "directories": {
      "output": "dist-release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "dist/**/*",
      "build/appicon.ico"
    ],
    "asar": false,
    "win": {
      "icon": "build/appicon.ico",
      "target": [
        "dir"
      ]
    }
  },
  "productName": "Aeolia"
}
