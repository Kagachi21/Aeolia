            float qy_3 = qy * qy * qy;
            float lenN = pow(max(qx_3 + qy_3, 0.0001), 0.33333333);
            sdf = lenN - r;
            d = float2(qx * qx, qy * qy * (py < 0.0 ? -1.0 : 1.0));
