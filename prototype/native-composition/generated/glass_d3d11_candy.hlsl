// Smooth Continuous Island Distance Field: Returns (insideDistPixels, inwardNormal.x, inwardNormal.y)
float3 notchDistanceField(
    float2 localPos,
    float2 halfSize,
    float topRadius,
    float bottomRadius,
    float nPower)
{
    float px = abs(localPos.x);
    float py = localPos.y;

    float maxRadius = min(halfSize.x, halfSize.y);
