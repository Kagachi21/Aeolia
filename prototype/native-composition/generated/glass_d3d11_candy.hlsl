        else
        {
            float qx_n = pow(max(qx, 0.0001), nPower);
            float qy_n = pow(max(qy, 0.0001), nPower);
            float lenN = pow(qx_n + qy_n, 1.0 / nPower);
            sdf = lenN - r;
            d = float2(pow(max(qx, 0.0001), nPower - 1.0), pow(max(qy, 0.0001), nPower - 1.0) * (py < 0.0 ? -1.0 : 1.0));
        }
